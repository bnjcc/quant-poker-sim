# Leave both values unset for browser-only demo mode.
# For private per-user cloud persistence, copy this file to .env.local and
# use the Project URL and publishable key from Supabase's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"
